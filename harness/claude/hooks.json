{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/no-commit-on-default.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "Bash|Read|Grep",
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/reserved-skills.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "Skill",
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/tap-approval.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "AskUserQuestion",
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/tap-approval.py",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/lazy-activate.py",
          "timeout": 5
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python \"{HOOKS}\"/lazy-activate.py",
          "timeout": 5
        }
      ]
    }
  ]
}
